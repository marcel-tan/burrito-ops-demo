! BurritoWorks store {{ site_id }} zone firewall
zone security STORE
zone security WAN
!
zone-pair security STORE-TO-WAN source STORE destination WAN
 service-policy type inspect STORE_TO_WAN_POLICY
!
zone-pair security WAN-TO-STORE source WAN destination STORE
{% if firewall_default_policy == 'deny' %}
 ! default deny, no service policy
{% else %}
 service-policy type inspect WAN_TO_STORE_POLICY
{% endif %}
!
logging host {{ syslog_server }}
snmp-server community {{ snmp_community }} RO
{% for server in ntp_servers %}
ntp server {{ server }}
{% endfor %}
!
